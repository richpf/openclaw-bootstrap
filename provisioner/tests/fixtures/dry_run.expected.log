#cloud-config
# ============================================================
# OpenClaw Lightsail Cloud-Init
# Implements Sections 1–13 of the hardening runbook.
# Generated for: testop  domain: example2.com
#
# SAFEGUARDS (lessons from prior lockout incident):
#   1. ssh.socket is MASKED — survives package updates & reboots
#   2. ubuntu account: password locked ONLY (passwd -l), NOT nologin
#      — preserves Lightsail browser console emergency access
#   3. SSH watchdog cron — auto-corrects port 2222 on every reboot
# ============================================================

users:
  # Keep default ubuntu user intact (browser console recovery path)
  - default

  # deployer: human operator account
  - name: deployer
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL:ALL) ALL"
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA DRY-RUN-OPERATOR-KEY deployer@dryrun

  # openclaw: service account (no login shell needed externally)
  - name: openclaw
    system: true
    shell: /bin/bash
    home: /home/openclaw
    groups: []
    no_user_group: false

write_files:
  # ── Section 3: SSH hardening config ──────────────────────────────
  - path: /etc/ssh/sshd_config.d/hardening.conf
    owner: root:root
    permissions: "0644"
    content: |
      # OpenClaw SSH hardening — generated by provisioner
      Port 2222
      Protocol 2

      PermitRootLogin no
      PasswordAuthentication no
      PubkeyAuthentication yes
      AuthenticationMethods publickey
      KbdInteractiveAuthentication no
      ChallengeResponseAuthentication no
      PermitEmptyPasswords no
      MaxAuthTries 3
      MaxSessions 3
      LoginGraceTime 30

      AllowUsers deployer
      DenyUsers root ubuntu

      AllowTcpForwarding no
      X11Forwarding no
      AllowAgentForwarding no
      PermitTunnel no
      GatewayPorts no

      KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512
      Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
      MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

      ClientAliveInterval 300
      ClientAliveCountMax 2
      TCPKeepAlive no

      LogLevel VERBOSE
      SyslogFacility AUTH

      Banner /etc/ssh/banner
      PrintMotd no
      PrintLastLog yes

      DebianBanner no
      UseDNS no
  ... (663 more lines) ...
