#cloud-config
# ============================================================
# OpenClaw Lightsail Cloud-Init
# Implements Sections 1–13 of the hardening runbook.
# Generated for: {{ slug }}  domain: {{ domain }}
#
# SAFEGUARDS (lessons from prior lockout incident):
#   1. ssh.socket is MASKED — survives package updates & reboots
#   2. ubuntu account: password locked ONLY (passwd -l), NOT nologin
#      — preserves Lightsail browser console emergency access
#   3. SSH watchdog cron — auto-corrects port 2222 on every reboot
# ============================================================

users:
  # Keep default ubuntu user intact (browser console recovery path)
  - default

  # deployer: human operator account
  - name: deployer
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL:ALL) ALL"
    ssh_authorized_keys:
      - {{ operator_pubkey }}
{%- if deployer_pubkey is defined and deployer_pubkey %}
      - {{ deployer_pubkey }}
{%- endif %}

  # openclaw: service account (no login shell needed externally)
  - name: openclaw
    system: true
    shell: /bin/bash
    home: /home/openclaw
    groups: []
    no_user_group: false

write_files:
  # ── Section 3: SSH hardening config ──────────────────────────────
  - path: /etc/ssh/sshd_config.d/hardening.conf
    owner: root:root
    permissions: "0644"
    content: |
      # OpenClaw SSH hardening — generated by provisioner
      Port 2222
      Protocol 2

      PermitRootLogin no
      PasswordAuthentication no
      PubkeyAuthentication yes
      AuthenticationMethods publickey
      KbdInteractiveAuthentication no
      ChallengeResponseAuthentication no
      PermitEmptyPasswords no
      MaxAuthTries 3
      MaxSessions 3
      LoginGraceTime 30

      AllowUsers deployer
      DenyUsers root ubuntu

      AllowTcpForwarding no
      X11Forwarding no
      AllowAgentForwarding no
      PermitTunnel no
      GatewayPorts no

      KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512
      Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
      MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

      ClientAliveInterval 300
      ClientAliveCountMax 2
      TCPKeepAlive no

      LogLevel VERBOSE
      SyslogFacility AUTH

      Banner /etc/ssh/banner
      PrintMotd no
      PrintLastLog yes

      DebianBanner no
      UseDNS no
      Compression no
      StrictModes yes

  # SSH warning banner
  - path: /etc/ssh/banner
    owner: root:root
    permissions: "0644"
    content: |
      *******************************************************************
      *  UNAUTHORIZED ACCESS TO THIS SYSTEM IS PROHIBITED.              *
      *  All connections are monitored and recorded.                     *
      *  Disconnect IMMEDIATELY if you are not an authorized user.       *
      *******************************************************************

  # ── Section 3-W: SSH Watchdog ────────────────────────────────────
  - path: /usr/local/bin/ssh-watchdog
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      # SSH Watchdog — ensures SSH is always listening on port 2222
      # Runs at every reboot (after 30s delay to allow system to stabilize)
      LOG="/var/log/openclaw/ssh-watchdog.log"
      mkdir -p /var/log/openclaw

      if ! ss -tlnp | grep -q ":2222 "; then
          echo "$(date -u) SSH watchdog: port 2222 not listening — correcting..." >> "$LOG"
          systemctl stop ssh.socket 2>/dev/null || true
          systemctl disable ssh.socket 2>/dev/null || true
          systemctl mask ssh.socket 2>/dev/null || true
          systemctl restart ssh
          if ss -tlnp | grep -q ":2222 "; then
              echo "$(date -u) SSH watchdog: port 2222 restored successfully" >> "$LOG"
          else
              echo "$(date -u) SSH watchdog: FAILED to restore port 2222 — manual intervention required" >> "$LOG"
          fi
      else
          echo "$(date -u) SSH watchdog: port 2222 OK" >> "$LOG"
      fi

  # SSH watchdog cron — runs at every reboot
  - path: /etc/cron.d/ssh-watchdog
    owner: root:root
    permissions: "0644"
    content: |
      @reboot root sleep 30 && /usr/local/bin/ssh-watchdog

  # ── Section 5: Unattended upgrades ──────────────────────────────
  - path: /etc/apt/apt.conf.d/50unattended-upgrades
    owner: root:root
    permissions: "0644"
    content: |
      Unattended-Upgrade::Allowed-Origins {
          "${distro_id}:${distro_codename}";
          "${distro_id}:${distro_codename}-security";
          "${distro_id}ESMApps:${distro_codename}-apps-security";
          "${distro_id}ESM:${distro_codename}-infra-security";
      };
      Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
      Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
      Unattended-Upgrade::Remove-Unused-Dependencies "true";
      // NOTE: ssh-watchdog cron corrects SSH port after every reboot
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "03:00";
      Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
      Unattended-Upgrade::SyslogEnable "true";
      Unattended-Upgrade::SyslogFacility "daemon";
      Unattended-Upgrade::Package-Blacklist {
          "nodejs";
          "npm";
          "nginx";
          "docker-ce";
      };

  - path: /etc/apt/apt.conf.d/20auto-upgrades
    owner: root:root
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      APT::Periodic::Download-Upgradeable-Packages "1";
      APT::Periodic::AutocleanInterval "7";

  # ── Section 6: fail2ban ─────────────────────────────────────────
  - path: /etc/fail2ban/jail.local
    owner: root:root
    permissions: "0644"
    content: |
      [DEFAULT]
      bantime = 86400
      findtime = 600
      maxretry = 3
      banaction = ufw
      banaction_allports = ufw
      loglevel = INFO
      logtarget = /var/log/fail2ban.log

      [sshd]
      enabled = true
      port = 2222
      filter = sshd
      logpath = /var/log/auth.log
      maxretry = 3
      findtime = 300
      bantime = 86400

      [sshd-ddos]
      enabled = true
      port = 2222
      filter = sshd-ddos
      logpath = /var/log/auth.log
      maxretry = 6
      findtime = 60
      bantime = 172800

      [nginx-http-auth]
      enabled = true
      port = http,https
      filter = nginx-http-auth
      logpath = /var/log/nginx/error.log
      maxretry = 5
      findtime = 300
      bantime = 3600

      [nginx-limit-req]
      enabled = true
      port = http,https
      filter = nginx-limit-req
      logpath = /var/log/nginx/error.log
      maxretry = 10
      findtime = 60
      bantime = 3600

      [recidive]
      enabled = true
      filter = recidive
      logpath = /var/log/fail2ban.log
      bantime = 604800
      findtime = 86400
      maxretry = 3
      banaction = ufw

      [telegram-webhook]
      enabled = true
      port = http,https
      filter = telegram-webhook
      logpath = /var/log/nginx/access.log
      maxretry = 20
      findtime = 60
      bantime = 3600

      [api-abuse]
      enabled = true
      port = http,https
      filter = api-abuse
      logpath = /var/log/nginx/access.log
      maxretry = 15
      findtime = 300
      bantime = 7200

  - path: /etc/fail2ban/filter.d/telegram-webhook.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Definition]
      failregex = ^<HOST> .* "(POST|GET) /webhook\S*" (403|404|400)
      ignoreregex = ^(149\.154\.(160|161|162|163|164|165|166|167|168|169|170|171|172|173|174|175)\.\d+|91\.108\.(4|5|6|7)\.\d+)

  - path: /etc/fail2ban/filter.d/api-abuse.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Definition]
      failregex = ^<HOST> .* "(POST|GET) /api\S*" (401|429)
                  ^<HOST> .* "(POST|GET) /v1\S*" (401|429)
      ignoreregex =

  # ── Section 7: AIDE custom rules ────────────────────────────────
  - path: /etc/aide/aide.conf.d/99_custom_rules.conf
    owner: root:root
    permissions: "0644"
    content: |
      /home/openclaw/.openclaw/openclaw.json$ Full
      /home/openclaw/.openclaw/.env$ Full
      /home/openclaw/.openclaw/ d Full
      /etc/ssh/ Full
      /home/deployer/.ssh/ Full
      /etc/passwd Full
      /etc/shadow Full
      /etc/group Full
      /etc/sudoers Full
      /etc/sudoers.d/ Full
      /etc/nginx/ Full
      /etc/systemd/ Full
      /etc/fail2ban/ Full
      /etc/cron.d/ Full
      /etc/crontab Full
      /var/spool/cron/ Full
      /usr/local/bin/ssh-watchdog Full

  # AIDE daily check cron
  - path: /etc/cron.d/aide-daily
    owner: root:root
    permissions: "0644"
    content: |
      # AIDE: run at 09:00 UTC with nice/ionice (avoids unattended-upgrades reboot window)
      0 9 * * * root /usr/bin/nice -n 19 /usr/bin/ionice -c 3 /usr/bin/aide --check --config /etc/aide/aide.conf > /var/log/aide/aide-check-$(date +\%Y\%m\%d).log 2>&1

  # AIDE update script
  - path: /usr/local/bin/aide-update
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      echo "Updating AIDE database..."
      aide --update --config /etc/aide/aide.conf
      cp /var/lib/aide/aide.db.new /var/lib/aide/aide.db
      echo "AIDE database updated at $(date)"

  # ── Section 8 + 10: Nginx config ────────────────────────────────
  - path: /etc/nginx/sites-available/openclaw
    owner: root:root
    permissions: "0644"
    content: |
      limit_req_zone $binary_remote_addr zone=general:10m rate=10r/s;
      limit_req_zone $binary_remote_addr zone=webhook:10m rate=30r/s;
      limit_req_zone $binary_remote_addr zone=dashboard:10m rate=5r/s;
      limit_conn_zone $binary_remote_addr zone=addr:10m;

      upstream streamlit {
          server 127.0.0.1:8501;
      }

      server {
          listen 80;
          server_name {{ domain }} www.{{ domain }};

          location /.well-known/acme-challenge/ {
              root /var/www/html;
          }

          location / {
              return 301 https://$host$request_uri;
          }
      }

      server {
          listen 443 ssl http2;
          server_name {{ domain }} www.{{ domain }};

          ssl_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
          ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;
          ssl_trusted_certificate /etc/letsencrypt/live/{{ domain }}/chain.pem;

          ssl_protocols TLSv1.2 TLSv1.3;
          ssl_prefer_server_ciphers on;
          ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
          ssl_session_timeout 1d;
          ssl_session_cache shared:SSL:10m;
          ssl_session_tickets off;
          ssl_stapling on;
          ssl_stapling_verify on;

          add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
          add_header X-Frame-Options "SAMEORIGIN" always;
          add_header X-Content-Type-Options "nosniff" always;
          add_header X-XSS-Protection "1; mode=block" always;
          add_header Referrer-Policy "strict-origin-when-cross-origin" always;
          add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws: wss:;" always;
          add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

          limit_conn addr 20;
          server_tokens off;
          client_max_body_size 10m;
          client_body_timeout 10s;
          client_header_timeout 10s;

          location /webhook/ {
              allow 149.154.160.0/20;
              allow 91.108.4.0/22;
              deny all;
              limit_req zone=webhook burst=50 nodelay;
              proxy_pass http://127.0.0.1:18789;
              proxy_http_version 1.1;
              proxy_set_header Host $host;
              proxy_set_header X-Real-IP $remote_addr;
              proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
              proxy_set_header X-Forwarded-Proto $scheme;
              proxy_read_timeout 60s;
          }

          location /dashboard/ {
              auth_basic "OpenClaw Dashboard";
              auth_basic_user_file /etc/nginx/.htpasswd;
              limit_req zone=dashboard burst=10 nodelay;
              proxy_pass http://streamlit/;
              proxy_http_version 1.1;
              proxy_set_header Host $host;
              proxy_set_header X-Real-IP $remote_addr;
              proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
              proxy_set_header X-Forwarded-Proto $scheme;
          }

          location /dashboard/_stcore/stream {
              auth_basic "OpenClaw Dashboard";
              auth_basic_user_file /etc/nginx/.htpasswd;
              proxy_pass http://streamlit/_stcore/stream;
              proxy_http_version 1.1;
              proxy_set_header Upgrade $http_upgrade;
              proxy_set_header Connection "upgrade";
              proxy_set_header Host $host;
              proxy_read_timeout 86400;
          }

          location /health {
              limit_req zone=general burst=5 nodelay;
              return 200 'OK';
              add_header Content-Type text/plain;
          }

          location / {
              return 444;
          }
      }

  - path: /etc/nginx/conf.d/security.conf
    owner: root:root
    permissions: "0644"
    content: |
      server_tokens off;
      client_body_buffer_size 1k;
      client_header_buffer_size 1k;
      large_client_header_buffers 2 1k;
      keepalive_timeout 10;
      send_timeout 10;

  # ── Section 9: Docker daemon hardening ──────────────────────────
  - path: /etc/docker/daemon.json
    owner: root:root
    permissions: "0644"
    content: |
      {
        "userns-remap": "default",
        "no-new-privileges": true,
        "log-driver": "json-file",
        "log-opts": {
          "max-size": "10m",
          "max-file": "3"
        },
        "default-ulimits": {
          "nofile": { "Name": "nofile", "Hard": 64000, "Soft": 64000 },
          "nproc": { "Name": "nproc", "Hard": 1024, "Soft": 512 }
        },
        "live-restore": true,
        "icc": false,
        "storage-driver": "overlay2"
      }

  # ── Section 10: Logrotate ────────────────────────────────────────
  - path: /etc/logrotate.d/openclaw
    owner: root:root
    permissions: "0644"
    content: |
      /var/log/openclaw/*.log {
          daily
          rotate 30
          compress
          delaycompress
          missingok
          notifempty
          create 640 openclaw openclaw
          sharedscripts
          postrotate
              systemctl kill -s HUP openclaw-gateway 2>/dev/null || true
          endscript
      }

  # ── Section 10: System health monitor ───────────────────────────
  - path: /usr/local/bin/system-health-check
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      LOG="/var/log/openclaw/system-health.log"
      TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

      DISK_PCT=$(df / | tail -1 | awk '{print $5}' | tr -d '%')
      if [ "$DISK_PCT" -gt 85 ]; then
          echo "$TIMESTAMP ALERT disk_usage_pct=$DISK_PCT" >> "$LOG"
      fi

      MEM_PCT=$(free | grep Mem | awk '{printf "%.0f", $3/$2 * 100}')
      if [ "$MEM_PCT" -gt 90 ]; then
          echo "$TIMESTAMP ALERT memory_usage_pct=$MEM_PCT" >> "$LOG"
      fi

      for SERVICE in openclaw-gateway nginx fail2ban docker tailscaled; do
          if ! systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
              echo "$TIMESTAMP ALERT service_down=$SERVICE" >> "$LOG"
          fi
      done

      if ! ss -tlnp | grep -q ":2222 "; then
          echo "$TIMESTAMP ALERT ssh_not_on_2222" >> "$LOG"
      fi

      SSH_FAILS=$(journalctl -u ssh --since "5 minutes ago" --no-pager 2>/dev/null | grep -c "Failed" || echo 0)
      if [ "$SSH_FAILS" -gt 5 ]; then
          echo "$TIMESTAMP ALERT ssh_failures_5m=$SSH_FAILS" >> "$LOG"
      fi

      MINUTE=$(date +%M)
      if [ "$MINUTE" -eq "00" ]; then
          echo "$TIMESTAMP OK disk=${DISK_PCT}% mem=${MEM_PCT}% ssh_fails_5m=$SSH_FAILS" >> "$LOG"
      fi

  - path: /etc/cron.d/system-health
    owner: root:root
    permissions: "0644"
    content: |
      */5 * * * * root /usr/local/bin/system-health-check

  # ── Section 11: Backup script ────────────────────────────────────
  - path: /usr/local/bin/openclaw-backup
    owner: openclaw:openclaw
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      TIMESTAMP=$(date +%Y%m%d-%H%M%S)
      BACKUP_DIR="/home/openclaw/backups"
      RETENTION_DAYS=30
      mkdir -p "$BACKUP_DIR"

      DBFILE="/home/openclaw/agent-system/data/openclaw.db"
      if [ -f "$DBFILE" ]; then
          sqlite3 "$DBFILE" ".backup '$BACKUP_DIR/openclaw-db-$TIMESTAMP.sqlite3'"
          echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) DB backup: openclaw-db-$TIMESTAMP.sqlite3"
      fi

      FAISS_DIR="/home/openclaw/agent-system/faiss"
      if [ -d "$FAISS_DIR" ]; then
          tar czf "$BACKUP_DIR/faiss-$TIMESTAMP.tar.gz" -C "$FAISS_DIR" .
      fi

      CONF_DIR="/home/openclaw/.openclaw"
      if [ -d "$CONF_DIR" ]; then
          tar czf "$BACKUP_DIR/config-$TIMESTAMP.tar.gz" \
              --exclude='.env' --exclude='*.key' --exclude='*.pem' \
              -C "$CONF_DIR" .
      fi

      find "$BACKUP_DIR" -type f -mtime +$RETENTION_DAYS -delete

  - path: /etc/cron.d/openclaw-backup
    owner: root:root
    permissions: "0644"
    content: |
      0 2 * * * openclaw /usr/local/bin/openclaw-backup >> /var/log/openclaw/backup.log 2>&1

  # ── Section 12: Sudoers hardening ───────────────────────────────
  - path: /etc/sudoers.d/hardening
    owner: root:root
    permissions: "0440"
    content: |
      Defaults timestamp_timeout=5
      Defaults logfile="/var/log/sudo.log"
      deployer ALL=(ALL:ALL) ALL

  # ── Section 12: Password quality ────────────────────────────────
  - path: /etc/security/pwquality.conf
    owner: root:root
    permissions: "0644"
    content: |
      minlen = 14
      dcredit = -1
      ucredit = -1
      lcredit = -1
      ocredit = -1
      maxrepeat = 3
      enforce_for_root

  # ── Section 13: Kernel hardening ────────────────────────────────
  - path: /etc/sysctl.d/99-security.conf
    owner: root:root
    permissions: "0644"
    content: |
      net.ipv4.ip_forward = 0
      net.ipv6.conf.all.forwarding = 0
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv6.conf.all.accept_redirects = 0
      net.ipv6.conf.default.accept_redirects = 0
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0
      net.ipv4.conf.all.secure_redirects = 0
      net.ipv4.conf.default.secure_redirects = 0
      net.ipv4.icmp_echo_ignore_broadcasts = 1
      net.ipv4.icmp_ignore_bogus_error_responses = 1
      net.ipv4.tcp_syncookies = 1
      net.ipv4.tcp_max_syn_backlog = 2048
      net.ipv4.tcp_synack_retries = 2
      net.ipv4.conf.all.rp_filter = 1
      net.ipv4.conf.default.rp_filter = 1
      net.ipv4.conf.all.log_martians = 1
      net.ipv4.conf.default.log_martians = 1
      net.ipv4.conf.all.accept_source_route = 0
      net.ipv4.conf.default.accept_source_route = 0
      net.ipv6.conf.all.accept_source_route = 0
      net.ipv6.conf.default.accept_source_route = 0
      net.ipv6.conf.all.disable_ipv6 = 1
      net.ipv6.conf.default.disable_ipv6 = 1
      kernel.dmesg_restrict = 1
      kernel.kptr_restrict = 2
      kernel.yama.ptrace_scope = 1
      kernel.randomize_va_space = 2
      fs.suid_dumpable = 0
      fs.protected_symlinks = 1
      fs.protected_hardlinks = 1
      fs.protected_fifos = 2
      fs.protected_regular = 2

  # Disable core dumps
  - path: /etc/profile.d/disable-coredumps.sh
    owner: root:root
    permissions: "0644"
    content: |
      ulimit -c 0

  # Umask hardening
  - path: /etc/profile.d/umask.sh
    owner: root:root
    permissions: "0644"
    content: |
      umask 027

  # Restic directory structure (S12 prep — no repo init without B2 creds)
  - path: /home/openclaw/.config/restic/.gitkeep
    owner: openclaw:openclaw
    permissions: "0600"
    content: ""

runcmd:
  # ── Section 1: System update ──────────────────────────────────────
  - [bash, -c, "DEBIAN_FRONTEND=noninteractive apt-get update -qq"]
  - [bash, -c, "DEBIAN_FRONTEND=noninteractive apt-get upgrade -y -qq"]
  - [bash, -c, "DEBIAN_FRONTEND=noninteractive apt-get dist-upgrade -y -qq"]
  - [bash, -c, "DEBIAN_FRONTEND=noninteractive apt-get autoremove -y -qq && apt-get autoclean -qq"]
  - [timedatectl, set-timezone, UTC]
  - [hostnamectl, set-hostname, "openclaw-{{ slug }}"]
  - [bash, -c, "echo '127.0.1.1 openclaw-{{ slug }}' >> /etc/hosts"]
  - [bash, -c, "DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl wget git build-essential ufw fail2ban aide nginx certbot python3-certbot-nginx sqlite3 python3-pip python3-venv jq tree htop iotop ncdu unattended-upgrades apt-listchanges logrotate rsync libpam-pwquality lynis chkrootkit rkhunter acl restic apache2-utils"]

  # ── Section 2: User accounts ──────────────────────────────────────
  # deployer account is created via cloud-config 'users' block above
  # Generate server-side ED25519 key for deployer
  - [bash, -c, "[ -f /home/deployer/.ssh/id_ed25519 ] || sudo -u deployer ssh-keygen -t ed25519 -C 'deployer@openclaw-{{ slug }}' -f /home/deployer/.ssh/id_ed25519 -N ''"]
  # openclaw: system account
  - [bash, -c, "id openclaw || useradd --system --shell /bin/bash --home /home/openclaw --create-home openclaw"]
  # Lock ubuntu password (SAFE — keeps browser console, does NOT set nologin)
  - [bash, -c, "passwd -l ubuntu"]
  # Ensure deployer .ssh perms
  - [bash, -c, "chmod 700 /home/deployer/.ssh && chmod 600 /home/deployer/.ssh/authorized_keys"]
  # sudoers syntax check
  - [bash, -c, "visudo -c -f /etc/sudoers.d/hardening"]

  # ── Section 3: SSH hardening ──────────────────────────────────────
  # Backup original sshd_config
  - [bash, -c, "cp /etc/ssh/sshd_config /etc/ssh/sshd_config.backup.$(date +%Y%m%d) 2>/dev/null || true"]
  # Remove small DH moduli
  - [bash, -c, "cp /etc/ssh/moduli /etc/ssh/moduli.backup && awk '$5 >= 3071' /etc/ssh/moduli > /etc/ssh/moduli.tmp && mv /etc/ssh/moduli.tmp /etc/ssh/moduli"]
  # SAFEGUARD 1: Mask ssh.socket so it cannot be re-enabled by package updates
  - [bash, -c, "systemctl disable --now ssh.socket 2>/dev/null || true"]
  - [bash, -c, "systemctl mask ssh.socket"]
  - [bash, -c, "systemctl daemon-reload"]
  - [bash, -c, "systemctl enable ssh"]
  # Validate config before restart
  - [bash, -c, "sshd -t && systemctl restart ssh"]
  # Verify listening on 2222
  - [bash, -c, "sleep 2 && ss -tlnp | grep -q ':2222 ' || (echo 'ERROR: SSH not on 2222' && exit 1)"]

  # ── Section 4: UFW ────────────────────────────────────────────────
  - [bash, -c, "ufw --force reset"]
  - [bash, -c, "ufw default deny incoming"]
  - [bash, -c, "ufw default allow outgoing"]
  - [bash, -c, "ufw allow from 100.64.0.0/10 to any port 2222 proto tcp comment 'SSH-via-Tailscale'"]
  - [bash, -c, "ufw allow 41641/udp comment 'Tailscale-direct'"]
  - [bash, -c, "ufw allow 443/tcp comment 'HTTPS-nginx'"]
  - [bash, -c, "ufw allow 80/tcp comment 'HTTP-LetsEncrypt-redirect'"]
  - [bash, -c, "ufw limit 2222/tcp comment 'SSH-rate-limit'"]
  - [bash, -c, "ufw deny 18789/tcp comment 'BLOCK-OpenClaw-Gateway'"]
  - [bash, -c, "ufw deny 18789/udp comment 'BLOCK-OpenClaw-Gateway-UDP'"]
  - [bash, -c, "ufw deny 23/tcp comment 'BLOCK-Telnet'"]
  - [bash, -c, "ufw deny 3306/tcp comment 'BLOCK-MySQL'"]
  - [bash, -c, "ufw deny 5432/tcp comment 'BLOCK-PostgreSQL'"]
  - [bash, -c, "ufw deny 6379/tcp comment 'BLOCK-Redis'"]
  - [bash, -c, "ufw deny 27017/tcp comment 'BLOCK-MongoDB'"]
  - [bash, -c, "ufw deny 8501/tcp comment 'BLOCK-Streamlit-direct'"]
  - [bash, -c, "ufw logging medium"]
  - [bash, -c, "ufw --force enable"]

  # ── Section 5: Tailscale ──────────────────────────────────────────
  - [bash, -c, "curl -fsSL https://tailscale.com/install.sh | sh"]
  - [bash, -c, "tailscale up --authkey={{ tailscale_auth_key }} --hostname=openclaw-{{ slug }} --ssh=false"]

  # ── Section 6: fail2ban ───────────────────────────────────────────
  - [bash, -c, "systemctl enable fail2ban && systemctl restart fail2ban"]

  # ── Section 7: AIDE file integrity ───────────────────────────────
  - [bash, -c, "mkdir -p /var/log/aide && chmod 750 /var/log/aide"]
  - [bash, -c, "[ -f /var/lib/aide/aide.db ] || (aideinit -y && cp /var/lib/aide/aide.db.new /var/lib/aide/aide.db)"]

  # ── Section 8 + 10: Nginx setup ──────────────────────────────────
  - [bash, -c, "rm -f /etc/nginx/sites-enabled/default"]
  - [bash, -c, "ln -sf /etc/nginx/sites-available/openclaw /etc/nginx/sites-enabled/openclaw"]
  - [bash, -c, "nginx -t"]
  - [bash, -c, "systemctl enable nginx"]
  # Certbot — run only if not already issued
  - [bash, -c, "[ -f /etc/letsencrypt/live/{{ domain }}/fullchain.pem ] || certbot --nginx -d {{ domain }} -d www.{{ domain }} --non-interactive --agree-tos -m {{ certbot_email }} --redirect"]
  - [bash, -c, "systemctl reload nginx || true"]

  # ── Section 9: Docker ─────────────────────────────────────────────
  - [bash, -c, "install -m 0755 -d /etc/apt/keyrings"]
  - [bash, -c, "curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg"]
  - [bash, -c, "chmod a+r /etc/apt/keyrings/docker.gpg"]
  - [bash, -c, "echo \"deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable\" > /etc/apt/sources.list.d/docker.list"]
  - [bash, -c, "DEBIAN_FRONTEND=noninteractive apt-get update -qq && apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-compose-plugin"]
  - [bash, -c, "usermod -aG docker openclaw"]
  - [bash, -c, "systemctl restart docker"]
  - [bash, -c, "docker network inspect openclaw-sandbox >/dev/null 2>&1 || docker network create --driver bridge --subnet 172.28.0.0/16 --opt com.docker.network.bridge.enable_ip_masquerade=false --opt com.docker.network.bridge.enable_icc=false openclaw-sandbox"]

  # ── Section 10: Logging dirs ──────────────────────────────────────
  - [bash, -c, "mkdir -p /var/log/openclaw && chown openclaw:openclaw /var/log/openclaw && chmod 750 /var/log/openclaw"]

  # ── Section 11: Disable unnecessary services ──────────────────────
  - [bash, -c, "systemctl disable --now cups-browsed.service 2>/dev/null || true"]
  - [bash, -c, "systemctl disable --now avahi-daemon.service 2>/dev/null || true"]
  - [bash, -c, "systemctl disable --now bluetooth.service 2>/dev/null || true"]
  - [bash, -c, "systemctl disable --now ModemManager.service 2>/dev/null || true"]
  - [bash, -c, "systemctl mask ctrl-alt-del.target"]

  # ── Section 12: Core dumps + kernel hardening ─────────────────────
  - [bash, -c, "echo '* hard core 0' >> /etc/security/limits.conf"]
  - [bash, -c, "sysctl --system"]

  # ── Section 12: Restic directory structure (no repo init) ─────────
  - [bash, -c, "mkdir -p /home/openclaw/backups /home/openclaw/.config/restic && chown -R openclaw:openclaw /home/openclaw"]

  # ── Section 13: Audit scripts ─────────────────────────────────────
  - [bash, -c, "mkdir -p /var/log/openclaw"]
  - [bash, -c, "rkhunter --update --quiet 2>/dev/null || true"]
  - [bash, -c, "lynis audit system --no-colors --quiet > /var/log/openclaw/lynis-initial-audit.log 2>&1 || true"]

  # ── Watchdog first run ────────────────────────────────────────────
  - [bash, -c, "/usr/local/bin/ssh-watchdog"]

  # ── Final sentinel ────────────────────────────────────────────────
  - [bash, -c, "mkdir -p /var/lib/openclaw && touch /var/lib/openclaw/lightsail-hardening-complete && echo 'Hardening complete: $(date -u)' > /var/lib/openclaw/lightsail-hardening-complete"]

final_message: |
  OpenClaw Lightsail hardening complete for instance openclaw-{{ slug }}.
  Sections 1-13 applied. SSH is on port 2222 (Tailscale only).
  Next: run the Track C installer: python3 install_openclaw.py state/{{ slug }}.json
