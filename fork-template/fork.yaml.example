# fork.yaml.example — OpenClaw Fork Configuration Schema
#
# Copy this file to fork.yaml, fill in every field, then run:
#   ./fork.sh fork.yaml [--out <dir>]
#
# Fields marked REQUIRED must be present or fork.sh will exit 1.
# Fields marked OPTIONAL can be left blank; they'll render as-is in templates.
#
# NOTE: operator identity and assistant persona are NO LONGER required here.
# The first-boot Telegram interview collects them from the new operator directly.
# If you want to pre-seed these values (e.g. for automated testing or gifting
# a pre-configured fork), add them under seed_from_yaml: below.

# ─── INFRASTRUCTURE ──────────────────────────────────────────────────────────
infra:
  aws_region: "us-east-1"          # REQUIRED. AWS region for Lightsail instance
  lightsail_plan: "medium_2_0"     # REQUIRED. Lightsail bundle ID (e.g. nano_2_0, micro_2_0, medium_2_0)
  public_static_ip: ""             # Fill after provisioning. Static IP attached to Lightsail instance
  tailscale_ip: ""                 # Fill after Tailscale setup. 100.x.x.x address of instance
  domain: "example2.com"           # REQUIRED. Primary domain for this fork (e.g. myassistant.com)
  certbot_email: "admin@example2.com" # REQUIRED. Email for Let's Encrypt cert registration
  service_health_url: ""           # OPTIONAL. URL for custom service health check in HEARTBEAT.md

# ─── GIT ─────────────────────────────────────────────────────────────────────
git:
  github_handle: "alex-oclaw"              # REQUIRED. GitHub username for this fork's repos
  workspace_remote: "git@github.com:alex-oclaw/workspace.git"   # REQUIRED. Private workspace repo SSH URL
  journal_remote: "git@github.com:alex-oclaw/journal.git"       # REQUIRED. Private journal repo SSH URL

# ─── EMAIL ───────────────────────────────────────────────────────────────────
email:
  gmail_address: "myassistant@gmail.com"  # REQUIRED. Gmail account (with app password) for this fork
                                           # Used for newsletter sending, notifications, etc.

# ─── TELEGRAM ────────────────────────────────────────────────────────────────
telegram:
  bot_token_env: "TELEGRAM_BOT_TOKEN"     # REQUIRED. Name of the env var holding the bot token.
                                           # The actual token must be in the fork's .env file (never committed).
  operator_id: ""                          # OPTIONAL pre-fill. If blank, auto-detected during first-boot
                                           # interview from the operator's first Telegram message.
                                           # (Get it from @userinfobot on Telegram if you want to pre-fill.)

# ─── BACKUP ──────────────────────────────────────────────────────────────────
backup:
  restic_b2_bucket: "myassistant-backup"  # REQUIRED. Backblaze B2 bucket name for Restic snapshots
  restic_password_env: "RESTIC_PASSWORD"  # REQUIRED. Name of env var holding Restic encryption password

# ─── LLM KEYS ────────────────────────────────────────────────────────────────
llm_keys:
  shared_from_parent: true   # If true, this fork shares the parent's LLM API keys (billing consolidated).
                              # Set to false if this fork should have its own keys.
  providers:
    - anthropic               # Claude (Opus, Sonnet, Claude Code)
    - openrouter              # Qwen, Minimax, and other models via OpenRouter
    - openai                  # GPT-series, Whisper, DALL-E
    - minimax                 # Minimax M1 (formatting, extraction)
    - tavily                  # Web search API

# ─── SEED FROM YAML (optional) ───────────────────────────────────────────────
#
# If populated, these values are rendered into SOUL.md / USER.md / IDENTITY.md
# at fork time, short-circuiting the corresponding first-boot interview questions.
# Leave this block commented out (or empty) to let the interview collect them.
#
# Use cases:
#   - Gifting a pre-configured fork to someone whose details you already know
#   - Automated testing of the fork rendering pipeline
#   - Re-deploying an existing operator's config to a fresh instance
#
# seed_from_yaml:
#   operator:
#     name: "Alex"
#     timezone: "US/Eastern"
#     channel: "telegram"
#     background: |
#       Describe the operator's professional background here.
#     goals:
#       - "Financial independence"
#       - "Build automated income streams"
#       - "Healthier work-life balance"
#     first_session: "2026-01-01"
#
#   assistant:
#     name: "Atlas"
#     creature: "Persistent intelligence in a purpose-built shell"
#     vibe: "Methodical, direct, gets things done. Not a corporate drone."
#     emoji: "🗺️"
#     mission_oneliner: "Financial independence and a life less constrained."
